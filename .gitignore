# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# manual interno (no se sube nunca al repo)
/manual-interno/

# base de datos descartable usada por los tests (ver vitest.global-setup.ts)
/prisma/test.db
/prisma/test.db-journal
/prisma/test.db-shm
/prisma/test.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts
