datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Roles {
  RoleID    Int        @id @default(autoincrement())
  Nombre    String     @unique @db.NVarChar(50)
  Usuarios  Usuarios[]
}

model Catalogos {
  id               Int         @id
  Nombre           String?     @db.NVarChar(100)
  Valor            String?     @db.NVarChar(100)
  idpadre          Int?
  idestado         Int?
  padre            Catalogos?  @relation("CatPadreHijo", fields: [idpadre], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hijos            Catalogos[] @relation("CatPadreHijo")
  estadoRel        Catalogos?  @relation("CatEstado", fields: [idestado], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogosEstados Catalogos[] @relation("CatEstado")
  
  usuarios         Usuarios[]
  estudiantes      Estudiantes[]
  periodos         Periodos[]
}

model Usuarios {
  UsuarioID     Int         @id @default(autoincrement())
  Cedula        String      @unique @db.NVarChar(15)
  PasswordHash  String      @db.NVarChar(256)
  RoleID        Int?
  EstadoID      Int?        @default(2)
  FechaCreacion DateTime?   @default(now()) @db.DateTime
  
  rol           Roles?      @relation(fields: [RoleID], references: [RoleID], onDelete: NoAction, onUpdate: NoAction)
  estado        Catalogos?  @relation(fields: [EstadoID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  profesor      Profesores?
  padre         Padres?
}

model Profesores {
  ProfesorID   Int         @id @default(autoincrement())
  UsuarioID    Int?        @unique
  Nombre       String      @db.NVarChar(50)
  Apellido     String      @db.NVarChar(50)
  Email        String?     @db.NVarChar(100)
  Telefono     String?     @db.NVarChar(20)
  Especialidad String?     @db.NVarChar(100)

  usuario      Usuarios?   @relation(fields: [UsuarioID], references: [UsuarioID], onDelete: NoAction, onUpdate: NoAction)
  materias     Materias[]
  notas        Notas[]
}

model Padres {
  PadreID      Int         @id @default(autoincrement())
  UsuarioID    Int?        @unique
  Nombre       String      @db.NVarChar(50)
  Apellido     String      @db.NVarChar(50)
  Email        String?     @db.NVarChar(100)
  Telefono     String?     @db.NVarChar(20)
  Direccion    String?     @db.NVarChar(200)

  usuario      Usuarios?   @relation(fields: [UsuarioID], references: [UsuarioID], onDelete: NoAction, onUpdate: NoAction)
  estudiantes  Estudiantes[]
  recalifs     SolicitudesRecalificacion[]
}

model Grados {
  GradoID      Int          @id @default(autoincrement())
  Nombre       String       @db.NVarChar(50)
  Nivel        String?      @db.NVarChar(30)
  CupoMaximo   Int?         @default(30)
  Paralelo     String?      @default("A") @db.NVarChar(5)

  estudiantes  Estudiantes[]
  materias     Materias[]
  matriculas   Matriculas[]
}

model Estudiantes {
  EstudianteID    Int          @id @default(autoincrement())
  PadreID         Int?
  Nombre          String       @db.NVarChar(50)
  Apellido        String       @db.NVarChar(50)
  FechaNacimiento DateTime?    @db.Date
  GradoID         Int?
  EstadoID        Int?         @default(2)

  padre           Padres?      @relation(fields: [PadreID], references: [PadreID], onDelete: NoAction, onUpdate: NoAction)
  grado           Grados?      @relation(fields: [GradoID], references: [GradoID], onDelete: NoAction, onUpdate: NoAction)
  estado          Catalogos?   @relation(fields: [EstadoID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notas           Notas[]
  matriculas      Matriculas[]
}

model Materias {
  MateriaID    Int          @id @default(autoincrement())
  Nombre       String       @db.NVarChar(100)
  ProfesorID   Int?
  GradoID      Int?
  Descripcion  String?      @db.NVarChar(200)

  profesor     Profesores?  @relation(fields: [ProfesorID], references: [ProfesorID], onDelete: NoAction, onUpdate: NoAction)
  grado        Grados?      @relation(fields: [GradoID], references: [GradoID], onDelete: NoAction, onUpdate: NoAction)
  notas        Notas[]
}

model Periodos {
  PeriodoID    Int          @id @default(autoincrement())
  Nombre       String       @db.NVarChar(50)
  AnioLectivo  String?      @db.NVarChar(20)
  FechaInicio  DateTime?    @db.Date
  FechaFin     DateTime?    @db.Date
  EstadoID     Int?         @default(2)

  estado       Catalogos?   @relation(fields: [EstadoID], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notas        Notas[]
}

model Notas {
  NotaID         Int          @id @default(autoincrement())
  EstudianteID   Int?
  MateriaID      Int?
  PeriodoID      Int?
  ProfesorID     Int?
  Nota           Decimal      @db.Decimal(4,2)
  FechaRegistro  DateTime?    @default(now()) @db.DateTime
  Observaciones  String?      @db.NVarChar(500)

  estudiante     Estudiantes? @relation(fields: [EstudianteID], references: [EstudianteID], onDelete: NoAction, onUpdate: NoAction)
  materia        Materias?    @relation(fields: [MateriaID], references: [MateriaID], onDelete: NoAction, onUpdate: NoAction)
  periodo        Periodos?    @relation(fields: [PeriodoID], references: [PeriodoID], onDelete: NoAction, onUpdate: NoAction)
  profesor       Profesores?  @relation(fields: [ProfesorID], references: [ProfesorID], onDelete: NoAction, onUpdate: NoAction)
  
  recalifs       SolicitudesRecalificacion[]

  @@unique([EstudianteID, MateriaID, PeriodoID])
}

model Matriculas {
  MatriculaID    Int          @id @default(autoincrement())
  EstudianteID   Int?
  GradoID        Int?
  AnioLectivo    String?      @default("2025-2026") @db.NVarChar(20)
  FechaMatricula DateTime?    @default(now()) @db.DateTime
  Estado         String?      @default("Activa") @db.NVarChar(20)

  estudiante     Estudiantes? @relation(fields: [EstudianteID], references: [EstudianteID], onDelete: NoAction, onUpdate: NoAction)
  grado          Grados?      @relation(fields: [GradoID], references: [GradoID], onDelete: NoAction, onUpdate: NoAction)
}

model SolicitudesRecalificacion {
  SolicitudID        Int          @id @default(autoincrement())
  NotaID             Int?
  PadreID            Int?
  Motivo             String       @db.NVarChar(500)
  Estado             String?      @default("Pendiente") @db.NVarChar(20)
  NotaAnterior       Decimal?     @db.Decimal(4,2)
  NotaNueva          Decimal?     @db.Decimal(4,2)
  FechaSolicitud     DateTime?    @default(now()) @db.DateTime
  FechaResolucion    DateTime?    @db.DateTime
  ComentarioProfesor String?      @db.NVarChar(500)

  nota               Notas?       @relation(fields: [NotaID], references: [NotaID], onDelete: NoAction, onUpdate: NoAction)
  padre              Padres?      @relation(fields: [PadreID], references: [PadreID], onDelete: NoAction, onUpdate: NoAction)
}

model Auditoria {
  LogID          Int          @id @default(autoincrement())
  TablaAfectada  String?      @db.NVarChar(50)
  Accion         String?      @db.NVarChar(50)
  RegistroID     Int?
  ValorAntiguo   String?      @db.NVarChar(max)
  ValorNuevo     String?      @db.NVarChar(max)
  FechaAccion    DateTime?    @default(now()) @db.DateTime
  Usuario        String?      @db.NVarChar(100)
}
